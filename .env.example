# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Database (PostgreSQL via Supabase Pooler) ──
DATABASE_URL=postgresql://postgres.project:YOUR_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=30
DIRECT_URL=postgresql://postgres.project:YOUR_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=30

# ── Auth ──
AUTH_SECRET=your-secret-key

# ── Moota (opsional) ──
MOOTA_API_URL=https://app.moota.co/api/v2
MOOTA_PERSONAL_TOKEN=

# ── App ──
NEXT_PUBLIC_APP_NAME=Razkindo ERP
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
NODE_ENV=production
STB_MODE=true
